{
  "_README": "Políticas IAM para el alephoo-worker. Aplicar con Terraform o AWS CLI. Ver infra/aws/setup.sh",

  "TaskRolePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "S3BucketAccess",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::conectar-documentos-clinicos-prod",
          "arn:aws:s3:::conectar-documentos-clinicos-prod/*",
          "arn:aws:s3:::conectar-documentos-clinicos-dev",
          "arn:aws:s3:::conectar-documentos-clinicos-dev/*"
        ]
      },
      {
        "Sid": "SecretsManagerRead",
        "Effect": "Allow",
        "Action": [
          "secretsmanager:GetSecretValue"
        ],
        "Resource": [
          "arn:aws:secretsmanager:sa-east-1:*:secret:conectar/*"
        ]
      }
    ]
  },

  "ExecutionRolePolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ECRPull",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken",
          "ecr:BatchCheckLayerAvailability",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchGetImage"
        ],
        "Resource": "*"
      },
      {
        "Sid": "CloudWatchLogs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws:logs:sa-east-1:*:log-group:/ecs/conectar/*"
      },
      {
        "Sid": "SecretsManagerForECS",
        "Effect": "Allow",
        "Action": [
          "secretsmanager:GetSecretValue"
        ],
        "Resource": [
          "arn:aws:secretsmanager:sa-east-1:*:secret:conectar/*"
        ]
      }
    ]
  },

  "RDSSecurityGroup": {
    "_note": "El SG del RDS debe permitir inbound TCP 5432 desde el SG del worker ECS. No abrir a 0.0.0.0/0."
  }
}
